{% extends 'admin/base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block page_title %}Admin Sign In{% endblock %}

{% block admin_wrapper_class %}auth-layout{% endblock %}

{% block admin_content_class %}auth-content{% endblock %}

{% block admin_body_class %}auth-body{% endblock %}

{% block admin_sidebar %}{% endblock %}

{% block admin_header %}{% endblock %}

{% block content %}
    <section class="admin-auth-card">
        <div class="admin-auth-card-header">
            <span class="admin-auth-eyebrow">WebHemi Admin</span>
            <h2>Admin login</h2>
            <p class="admin-auth-subtitle">
                Sign in to manage sites, roles, permissions, users, and host verification from the admin panel.
            </p>
        </div>

        <div class="admin-auth-card-body">
            {% if error %}
                <div class="alert alert-failed login-error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {{ form_start(loginForm) }}
                <div class="form-group">
                    {{ form_label(loginForm._username) }}
                    {{ form_widget(loginForm._username) }}
                </div>
                <div class="form-group">
                    {{ form_label(loginForm._password) }}
                    {{ form_widget(loginForm._password) }}
                </div>
                {{ form_widget(loginForm._csrf_token) }}
                <button type="submit" class="btn btn-primary">Sign in</button>
            {{ form_end(loginForm) }}

            <div class="admin-auth-meta">
                <div>Version: {{ app_version }}</div>
                <div>Build: {{ app_build }}</div>
                <div>Commit: {{ app_commit }}</div>
            </div>
        </div>
    </section>
{% endblock %}
