{% extends "admin/base.html.twig" %}

{% block page_title %}Role Details{% endblock %}

{% block content %}
    <div style="margin-bottom: 20px;">
        <a href="{{ path('admin_role_list') }}" class="btn btn-secondary btn-small">&larr; Back to Roles</a>
    </div>

    <table>
        <tbody>
            <tr>
                <th style="width: 200px;">Name</th>
                <td><code>{{ role.name }}</code></td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ role.label }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>
                    {% if role.isReadOnly %}
                        <span style="color: #8e44ad;">Built-in (read-only)</span>
                    {% else %}
                        <span style="color: #7f8c8d;">Custom</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Permissions</th>
                <td>{{ role.permissions|length }}</td>
            </tr>
            <tr>
                <th>Users</th>
                <td>{{ role.userRoles|length }}</td>
            </tr>
        </tbody>
    </table>

    <div style="margin-top: 20px;">
        <h3 style="margin-bottom: 10px;">Related Permissions</h3>
        {% if role.permissions is empty %}
            <p style="color: #777;">No permissions assigned.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th style="width: 140px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for permission in role.permissions %}
                        <tr>
                            <td><code>{{ permission.name }}</code> - {{ permission.label }}</td>
                            <td>
                                {% if is_granted('permission.view') %}
                                    <a href="{{ path('admin_permission_show', {id: permission.id}) }}" class="btn btn-primary btn-small">View</a>
                                {% else %}
                                    <span style="color: #7f8c8d;">No access</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <h3 style="margin: 20px 0 10px;">Related Users</h3>
        {% if role.userRoles is empty %}
            <p style="color: #777;">No users assigned.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th style="width: 140px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in role.userRoles %}
                        <tr>
                            <td>{{ user.email }}</td>
                            <td>
                                {% if is_granted('user.view') %}
                                    <a href="{{ path('admin_user_show', {id: user.id}) }}" class="btn btn-primary btn-small">View</a>
                                {% else %}
                                    <span style="color: #7f8c8d;">No access</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% if not role.isReadOnly and (is_granted('role.edit') or is_granted('role.delete')) %}
        <div class="btn-group" style="margin-top: 24px;">
            {% if is_granted('role.edit') %}
                <a href="{{ path('admin_role_edit', {id: role.id}) }}" class="btn btn-primary">Edit</a>
            {% endif %}
            {% if is_granted('role.delete') and role.userRoles|length == 0 %}
                <form method="POST" action="{{ path('admin_role_delete', {id: role.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure?');">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
