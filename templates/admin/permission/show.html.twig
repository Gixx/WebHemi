{% extends "admin/base.html.twig" %}

{% block page_title %}Permission Details{% endblock %}

{% block content %}
    <div style="margin-bottom: 20px;">
        <a href="{{ path('admin_permission_list') }}" class="btn btn-secondary btn-small">&larr; Back to Permissions</a>
    </div>

    <table>
        <tbody>
            <tr>
                <th style="width: 200px;">Name</th>
                <td><code>{{ permission.name }}</code></td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ permission.label }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>
                    {% if permission.isReadOnly %}
                        <span style="color: #8e44ad;">Built-in (read-only)</span>
                    {% else %}
                        <span style="color: #7f8c8d;">Custom</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Assigned Roles</th>
                <td>{{ permission.roles|length }}</td>
            </tr>
        </tbody>
    </table>

    <div style="margin-top: 20px;">
        <h3 style="margin-bottom: 10px;">Related Roles</h3>
        {% if permission.roles is empty %}
            <p style="color: #777;">No roles assigned.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th style="width: 140px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for role in permission.roles %}
                        <tr>
                            <td><code>{{ role.name }}</code> - {{ role.label }}</td>
                            <td>
                                {% if is_granted('role.view') %}
                                    <a href="{{ path('admin_role_show', {id: role.id}) }}" class="btn btn-primary btn-small">View</a>
                                {% else %}
                                    <span style="color: #7f8c8d;">No access</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% if not permission.isReadOnly and (is_granted('permission.edit') or is_granted('permission.delete')) %}
        <div class="btn-group" style="margin-top: 24px;">
            {% if is_granted('permission.edit') %}
                <a href="{{ path('admin_permission_edit', {id: permission.id}) }}" class="btn btn-primary">Edit</a>
            {% endif %}
            {% if is_granted('permission.delete') %}
                <form method="POST" action="{{ path('admin_permission_delete', {id: permission.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure?');">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
