<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin - WebHemi{% endblock %}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f5f5f5;
            color: #333;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .admin-wrapper.auth-layout {
            display: block;
            background:
                radial-gradient(circle at top right, rgba(52, 152, 219, 0.18), transparent 32%),
                linear-gradient(180deg, #f8fbff 0%, #eef3f8 100%);
        }

        .admin-sidebar {
            width: 250px;
            background-color: #2c3e50;
            color: white;
            padding: 20px 0;
            overflow-y: auto;
        }

        .admin-sidebar h2 {
            padding: 0 20px 20px;
            font-size: 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 16px 20px;
            padding: 10px;
            border-radius: 8px;
            background-color: rgba(255, 255, 255, 0.08);
        }

        .admin-user img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            background-color: rgba(255, 255, 255, 0.2);
        }

        .admin-user-email {
            max-width: 160px;
            font-size: 12px;
            word-break: break-all;
            color: rgba(255, 255, 255, 0.9);
        }

        .admin-sidebar nav a {
            display: block;
            padding: 12px 20px;
            color: white;
            text-decoration: none;
            transition: background-color 0.2s;
        }

        .admin-sidebar nav a:hover,
        .admin-sidebar nav a.active {
            background-color: #34495e;
        }

        .admin-sidebar nav a.logout-link {
            margin-top: 12px;
            color: #ffd6d6;
        }

        .admin-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .admin-content.auth-content {
            max-width: 520px;
            min-height: 100vh;
            margin: 0 auto;
            justify-content: center;
        }

        .admin-header {
            background-color: white;
            border-bottom: 1px solid #ddd;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-header h1 {
            font-size: 24px;
        }

        .admin-body {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
        }

        .admin-body.auth-body {
            padding: 32px 24px;
            overflow: visible;
        }

        .flash-messages {
            margin-bottom: 20px;
        }

        .alert {
            padding: 12px 20px;
            margin-bottom: 10px;
            border-radius: 4px;
            border-left: 4px solid;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border-color: #28a745;
        }

        .alert-error {
            background-color: #f8d7da;
            color: #721c24;
            border-color: #f5c6cb;
        }

        .alert-failed {
            background-color: #f8d7da;
            color: #721c24;
            border-color: #f5c6cb;
        }

        .alert-warning {
            background-color: #fff3cd;
            color: #856404;
            border-color: #ffeeba;
        }

        .login-error {
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            border-radius: 4px;
            overflow: hidden;
        }

        th {
            background-color: #ecf0f1;
            padding: 12px;
            text-align: left;
            font-weight: 600;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #ecf0f1;
        }

        tr:hover {
            background-color: #f9f9f9;
        }

        .btn {
            display: inline-block;
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
            transition: opacity 0.2s;
        }

        .btn-primary {
            background-color: #3498db;
            color: white;
        }

        .btn-primary:hover {
            opacity: 0.9;
        }

        .btn-danger {
            background-color: #e74c3c;
            color: white;
        }

        .btn-danger:hover {
            opacity: 0.9;
        }

        .btn-success {
            background-color: #27ae60;
            color: white;
        }

        .btn-success:hover {
            opacity: 0.9;
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 12px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="url"],
        select,
        textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-family: inherit;
            font-size: 14px;
        }

        input[type="checkbox"] {
            margin-right: 5px;
        }

        .btn-group {
            display: flex;
            gap: 10px;
        }

        .admin-meta {
            margin-top: 24px;
            padding: 0 20px;
            color: rgba(255, 255, 255, 0.75);
            font-size: 12px;
            line-height: 1.5;
        }

        .admin-auth-card {
            background-color: white;
            border: 1px solid #dbe4ee;
            border-radius: 16px;
            box-shadow: 0 24px 60px rgba(44, 62, 80, 0.12);
            overflow: hidden;
        }

        .admin-auth-card-header {
            padding: 32px 32px 20px;
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
        }

        .admin-auth-eyebrow {
            display: inline-block;
            margin-bottom: 10px;
            padding: 4px 10px;
            border-radius: 999px;
            background-color: rgba(255, 255, 255, 0.12);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .admin-auth-card-header h2 {
            margin: 0;
            font-size: 28px;
        }

        .admin-auth-subtitle {
            margin-top: 10px;
            color: rgba(255, 255, 255, 0.82);
            line-height: 1.5;
        }

        .admin-auth-card-body {
            padding: 32px;
        }

        .admin-auth-card .btn {
            width: 100%;
            justify-content: center;
            padding: 12px 18px;
            font-size: 15px;
            font-weight: 600;
        }

        .admin-auth-meta {
            margin-top: 18px;
            color: #6b7785;
            font-size: 13px;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <div class="admin-wrapper {% block admin_wrapper_class %}{% endblock %}">
        {% block admin_sidebar %}
            <aside class="admin-sidebar">
                <h2>Admin</h2>
                <nav>
                    {% if app.user %}
                        <div class="admin-user">
                            <img src="{{ app.user.avatarUrl }}" alt="Avatar">
                            <div class="admin-user-email">{{ app.user.userIdentifier }}</div>
                        </div>
                    {% endif %}
                    {% if is_granted('dashboard.view') %}
                        <a href="{{ path('admin_dashboard') }}" {% if app.request.attributes.get('_route') starts with 'admin_dashboard' %}class="active"{% endif %}>Dashboard</a>
                    {% endif %}
                    {% if is_granted('site.list') %}
                        <a href="{{ path('admin_site_list') }}" {% if app.request.attributes.get('_route') starts with 'admin_site_' %}class="active"{% endif %}>Sites</a>
                    {% endif %}
                    {% if is_granted('permission.list') %}
                        <a href="{{ path('admin_permission_list') }}" {% if app.request.attributes.get('_route') starts with 'admin_permission_' %}class="active"{% endif %}>Permissions</a>
                    {% endif %}
                    {% if is_granted('role.list') %}
                        <a href="{{ path('admin_role_list') }}" {% if app.request.attributes.get('_route') starts with 'admin_role_' %}class="active"{% endif %}>Roles</a>
                    {% endif %}
                    {% if is_granted('user.list') %}
                        <a href="{{ path('admin_user_list') }}" {% if app.request.attributes.get('_route') starts with 'admin_user_' %}class="active"{% endif %}>Users</a>
                    {% endif %}
                    <a href="{{ path('_logout_main') }}" class="logout-link">Logout</a>
                </nav>
                <div class="admin-meta">
                    <div>Version: {{ app_version }}</div>
                    <div>Build: {{ app_build }}</div>
                    <div>Commit: {{ app_commit }}</div>
                </div>
            </aside>
        {% endblock %}

        <div class="admin-content {% block admin_content_class %}{% endblock %}">
            {% block admin_header %}
                <header class="admin-header">
                    <h1>{% block page_title %}WebHemi Admin{% endblock %}</h1>
                </header>
            {% endblock %}

            <main class="admin-body {% block admin_body_class %}{% endblock %}">
                {% set flashes = app.flashes %}
                {% if flashes is not empty %}
                    <div class="flash-messages">
                        {% for type, messages in flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ type }}">{{ message }}</div>
                            {% endfor %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% block content %}{% endblock %}
            </main>
        </div>
    </div>
</body>
</html>
