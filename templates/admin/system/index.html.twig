{% extends "admin/base.html.twig" %}
{% block page_title %}System{% endblock %}
{% block content %}
<style>
    .system-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 24px;
        padding: 8px 0;
    }
    .system-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        padding: 28px 20px 22px;
        background: #ffffff;
        border: 1px solid #e8eaed;
        border-radius: 12px;
        text-decoration: none;
        color: #2c3548;
        transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
    }
    .system-card:hover {
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.10);
        transform: translateY(-2px);
        border-color: #c8d0dc;
        color: #1a2138;
    }
    .system-card-icon {
        width: 72px;
        height: 72px;
    }
    .system-card-label {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.01em;
    }
</style>
<h2>System</h2>
<p style="margin-bottom: 28px; color: #6b7785;">Manage the core building blocks of WebHemi.</p>
<div class="system-grid">
    {% if is_granted('site.list') %}
        <a href="{{ path('admin_site_list') }}" class="system-card">
            <img src="{{ asset('assets/admin/icons/system/sites.svg') }}" alt="Sites icon" class="system-card-icon">
            <span class="system-card-label">Sites</span>
        </a>
    {% endif %}
    {% if is_granted('permission.list') %}
        <a href="{{ path('admin_permission_list') }}" class="system-card">
            <img src="{{ asset('assets/admin/icons/system/permissions.svg') }}" alt="Permissions icon" class="system-card-icon">
            <span class="system-card-label">Permissions</span>
        </a>
    {% endif %}
    {% if is_granted('role.list') %}
        <a href="{{ path('admin_role_list') }}" class="system-card">
            <img src="{{ asset('assets/admin/icons/system/roles.svg') }}" alt="Roles icon" class="system-card-icon">
            <span class="system-card-label">Roles</span>
        </a>
    {% endif %}
    {% if is_granted('user.list') %}
        <a href="{{ path('admin_user_list') }}" class="system-card">
            <img src="{{ asset('assets/admin/icons/system/users.svg') }}" alt="Users icon" class="system-card-icon">
            <span class="system-card-label">Users</span>
        </a>
    {% endif %}
</div>
{% endblock %}
