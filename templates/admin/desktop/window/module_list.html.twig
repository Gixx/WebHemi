<div class="desktop-window-module">
    <h3>{{ title }}</h3>

    {% if rows is empty %}
        <p>{{ emptyMessage }}</p>
    {% else %}
        <table class="desktop-window-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.name }}</td>
                        <td>
                            <a href="{{ row.url }}" class="desktop-link-button">Open</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

</div>
