<div class="desktop-window-module">
    <h3>Control Panel</h3>
    <p>Open the core admin modules. Content is loaded only when each window is opened.</p>

    <div class="desktop-control-grid">
        {% if is_granted('site.list') %}
            <button
                type="button"
                class="desktop-control-item js-desktop-launch"
                data-window-id="module-sites"
                data-window-title="Sites"
                data-window-url="{{ path('admin_site_list') }}"
                data-window-width="760"
                data-window-height="520"
            >
                <img src="/assets/admin/icons/system/sites.svg" alt="Sites">
                <span>Sites</span>
            </button>
        {% endif %}

        {% if is_granted('permission.list') %}
            <button
                type="button"
                class="desktop-control-item js-desktop-launch"
                data-window-id="module-permissions"
                data-window-title="Permissions"
                data-window-url="{{ path('admin_permission_list') }}"
                data-window-width="760"
                data-window-height="520"
            >
                <img src="/assets/admin/icons/system/permissions.svg" alt="Permissions">
                <span>Permissions</span>
            </button>
        {% endif %}

        {% if is_granted('role.list') %}
            <button
                type="button"
                class="desktop-control-item js-desktop-launch"
                data-window-id="module-roles"
                data-window-title="Roles"
                data-window-url="{{ path('admin_role_list') }}"
                data-window-width="760"
                data-window-height="520"
            >
                <img src="/assets/admin/icons/system/roles.svg" alt="Roles">
                <span>Roles</span>
            </button>
        {% endif %}

        {% if is_granted('user.list') %}
            <button
                type="button"
                class="desktop-control-item js-desktop-launch"
                data-window-id="module-users"
                data-window-title="Users"
                data-window-url="{{ path('admin_user_list') }}"
                data-window-width="760"
                data-window-height="520"
            >
                <img src="/assets/admin/icons/system/users.svg" alt="Users">
                <span>Users</span>
            </button>
        {% endif %}
    </div>
</div>
